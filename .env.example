# Copy to .env and fill in your values.
# docker compose automatically loads .env from the project root.

# ── App ───────────────────────────────────────────────────────────────────────

# Required. Password to unlock the camera wall.
PASSWORD=changeme

# Optional. Host port exposed by the app (default 3000).
# Change this if port 3000 is already in use on your machine.
# PORT=3000

# Optional. Signed-cookie secret — auto-generated at startup if omitted,
# which means all sessions are invalidated on container restart.
# Set a fixed value to persist sessions across restarts.
# SESSION_SECRET=

# Optional. URL of the mediamtx HLS server, as seen from the app container.
# Only change this if you rename the mediamtx service or run it externally.
MEDIAMTX_URL=http://mediamtx:8888

# Comma-separated camera list shown on the wall.
# Format: <pathId>:<Display Label>
# pathId must match the mediamtx path name used below (cam1, cam2, …).
CAMERAS=cam1:Front Door,cam2:Back Yard,cam3:Garage,cam4:Driveway,cam5:Side Gate,cam6:Pool

# ── Camera sources (H.264 cameras — pass-through, no transcoding) ─────────────
# Use this simpler format if your cameras output H.264 on the sub-stream.
# Path names (CAM1, CAM2 …) must match the ids in CAMERAS above.
# If your password contains @ encode it as %40 (e.g. pass@word → pass%40word).

# MTX_PATHS_CAM1_SOURCE=rtsp://user:password@192.168.1.101/stream2
# MTX_PATHS_CAM2_SOURCE=rtsp://user:password@192.168.1.102/stream2
# MTX_PATHS_CAM3_SOURCE=rtsp://user:password@192.168.1.103/stream2
# MTX_PATHS_CAM4_SOURCE=rtsp://user:password@192.168.1.104/stream2
# MTX_PATHS_CAM5_SOURCE=rtsp://user:password@192.168.1.105/stream2
# MTX_PATHS_CAM6_SOURCE=rtsp://user:password@192.168.1.106/stream2

# ── Camera sources (H.265/HEVC cameras — on-demand transcoding) ───────────────
# Use this format if your cameras output H.265. Requires the mediamtx:latest-ffmpeg
# image (already set in docker-compose.yml).
#
# ffmpeg only starts when a viewer opens the wall and stops ~10 s after they
# leave — no transcoding CPU cost when nobody is watching.
#
# If your password contains @ encode it as %40 (e.g. pass@word → pass%40word).

# MTX_PATHS_CAM1_RUNONDEMAND=ffmpeg -loglevel error -rtsp_transport tcp -i rtsp://user:password@192.168.1.101/stream2 -c:v libx264 -preset ultrafast -tune zerolatency -g 60 -keyint_min 60 -sc_threshold 0 -force_key_frames expr:gte(t,n_forced*1) -b:v 1000k -an -f rtsp rtsp://localhost:8554/cam1
# MTX_PATHS_CAM1_RUNONDEMANDRESTART=yes
#
# MTX_PATHS_CAM2_RUNONDEMAND=ffmpeg -loglevel error -rtsp_transport tcp -i rtsp://user:password@192.168.1.102/stream2 -c:v libx264 -preset ultrafast -tune zerolatency -g 60 -keyint_min 60 -sc_threshold 0 -force_key_frames expr:gte(t,n_forced*1) -b:v 1000k -an -f rtsp rtsp://localhost:8554/cam2
# MTX_PATHS_CAM2_RUNONDEMANDRESTART=yes
#
# MTX_PATHS_CAM3_RUNONDEMAND=ffmpeg -loglevel error -rtsp_transport tcp -i rtsp://user:password@192.168.1.103/stream2 -c:v libx264 -preset ultrafast -tune zerolatency -g 60 -keyint_min 60 -sc_threshold 0 -force_key_frames expr:gte(t,n_forced*1) -b:v 1000k -an -f rtsp rtsp://localhost:8554/cam3
# MTX_PATHS_CAM3_RUNONDEMANDRESTART=yes
#
# MTX_PATHS_CAM4_RUNONDEMAND=ffmpeg -loglevel error -rtsp_transport tcp -i rtsp://user:password@192.168.1.104/stream2 -c:v libx264 -preset ultrafast -tune zerolatency -g 60 -keyint_min 60 -sc_threshold 0 -force_key_frames expr:gte(t,n_forced*1) -b:v 1000k -an -f rtsp rtsp://localhost:8554/cam4
# MTX_PATHS_CAM4_RUNONDEMANDRESTART=yes
#
# MTX_PATHS_CAM5_RUNONDEMAND=ffmpeg -loglevel error -rtsp_transport tcp -i rtsp://user:password@192.168.1.105/stream2 -c:v libx264 -preset ultrafast -tune zerolatency -g 60 -keyint_min 60 -sc_threshold 0 -force_key_frames expr:gte(t,n_forced*1) -b:v 1000k -an -f rtsp rtsp://localhost:8554/cam5
# MTX_PATHS_CAM5_RUNONDEMANDRESTART=yes
#
# MTX_PATHS_CAM6_RUNONDEMAND=ffmpeg -loglevel error -rtsp_transport tcp -i rtsp://user:password@192.168.1.106/stream2 -c:v libx264 -preset ultrafast -tune zerolatency -g 60 -keyint_min 60 -sc_threshold 0 -force_key_frames expr:gte(t,n_forced*1) -b:v 1000k -an -f rtsp rtsp://localhost:8554/cam6
# MTX_PATHS_CAM6_RUNONDEMANDRESTART=yes
