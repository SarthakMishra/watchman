# Copy to .env and fill in your values.
# docker compose automatically loads .env from the project root.

# ── App ───────────────────────────────────────────────────────────────────────

# Required. Password to unlock the camera wall.
PASSWORD=changeme

# Optional. Signed-cookie secret — auto-generated at startup if omitted,
# which means all sessions are invalidated on container restart.
# Set a fixed value to persist sessions across restarts.
# SESSION_SECRET=

# Optional. Port the app listens on inside the container (default 3000).
# PORT=3000

# Optional. URL of the mediamtx HLS server, as seen from the app container.
# Only change this if you rename the mediamtx service or run it externally.
MEDIAMTX_URL=http://mediamtx:8888

# Comma-separated list of cameras.
# Format: <pathId>:<Display Label>
# pathId must exactly match the mediamtx path name (MTX_PATHS_<PATHID>_SOURCE).
CAMERAS=cam1:Front Door,cam2:Back Yard,cam3:Garage,cam4:Driveway,cam5:Side Gate,cam6:Pool

# ── mediamtx ─────────────────────────────────────────────────────────────────
# These are passed to the mediamtx container, not the app.
# Add one line per camera. Use /stream2 (sub-stream) to save bandwidth.

# MTX_PATHS_CAM1_SOURCE=rtsp://admin:password@192.168.1.101/stream2
# MTX_PATHS_CAM2_SOURCE=rtsp://admin:password@192.168.1.102/stream2
# MTX_PATHS_CAM3_SOURCE=rtsp://admin:password@192.168.1.103/stream2
# MTX_PATHS_CAM4_SOURCE=rtsp://admin:password@192.168.1.104/stream2
# MTX_PATHS_CAM5_SOURCE=rtsp://admin:password@192.168.1.105/stream2
# MTX_PATHS_CAM6_SOURCE=rtsp://admin:password@192.168.1.106/stream2
